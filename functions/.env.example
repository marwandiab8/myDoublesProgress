TIME_LEFT_CALENDAR_ID=REPLACE_WITH_TIME_LEFT_CALENDAR_ID
TIME_LEFT_CONNECTION_ID=REPLACE_WITH_TIME_LEFT_MYDOUBLEPROGRESS_CONNECTION_ID
TIME_LEFT_SINGLE_INGEST_ENDPOINT=https://northamerica-northeast1-timelefttolive.cloudfunctions.net/ingestExternalDailyItem
TIME_LEFT_BATCH_INGEST_ENDPOINT=https://northamerica-northeast1-timelefttolive.cloudfunctions.net/ingestExternalDailyItemsBatch
MYDOUBLE_FIREBASE_PROJECT_ID=mydoublesprogress
MYDOUBLE_SOURCE_PROJECT_ID=mydoublesprogress
MYDOUBLE_APP_BASE_URL=https://mydoublesprogress.web.app
MYDOUBLE_OWNER_UID=REPLACE_WITH_MYDOUBLEPROGRESS_USER_UID
# IANA timezone used to date sessions saved before the app recorded `localDate`.
MYDOUBLE_TIMEZONE=America/Toronto

# Set the token as a Firebase Functions secret, not in this file:
# firebase functions:secrets:set TIME_LEFT_INGESTION_TOKEN --project mydoublesprogress
